# ============================================================
# Ember & Ivy — Environment Configuration
# Copy this file to `.env.local` and fill in your keys.
# The site runs in full demo mode without any of these.
# ============================================================

# --- Supabase ---
# Create a project at https://supabase.com, then run /supabase/schema.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- EmailJS ---
# Create an account at https://www.emailjs.com (Service + Template)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Admin ---
# Used only in demo mode (no Supabase configured).
# With Supabase configured, sign in with the email/password you created.
VITE_ADMIN_EMAIL=admin@emberandivy.com
VITE_ADMIN_PASSWORD=ember-admin

# --- Contact / venue ---
VITE_EMAIL=hello@emberandivy.com
VITE_PHONE=+977-980-000-0000
