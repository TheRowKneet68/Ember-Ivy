# ============================================================
# Ember & Ivy — Environment Configuration
# Copy this file to `.env.local` and fill in your keys.
# The site runs in full demo mode (localStorage demo data + demo
# admin login) when Supabase is NOT configured, so nothing below
# is required for local development.
# ============================================================

#  Supabase (REQUIRED for production backend) 
# 1. Create a free project at https://supabase.com
# 2. Open SQL Editor and run the file `supabase/schema.sql`
# 3. Enable Auth > Providers > Email
# 4. Add an admin user under Auth > Users (used to sign in at /admin)
# 5. Copy the project URL + ANON key here.
#    IMPORTANT: use the "anon" public key, NEVER the service_role key.
#    The service_role key bypasses Row Level Security and must never be
#    placed in client-side code or committed to the repository.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key






#  Admin (demo mode only) 
# These are used ONLY when Supabase is NOT configured (demo mode).
# With Supabase configured, sign in with the email/password you
# created under Supabase Auth > Users instead.
VITE_ADMIN_EMAIL=admin@emberandivy.com
VITE_ADMIN_PASSWORD=ember-admin

#  Contact / venue (shown across the site) 
VITE_EMAIL=hello@emberandivy.com
VITE_PHONE=+977 9744346285

